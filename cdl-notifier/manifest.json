{
  "manifest_version": 3,
  "name": "CDL Lead Notifier",
  "version": "1.1.0",
  "description": "Desktop notification the moment a lead is assigned to you in Zoho CRM.",
  "permissions": [
    "notifications",
    "alarms",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "options.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "host_permissions": [
    "https://cdl-realtime-server-orbw.onrender.com/*"
  ]
}
